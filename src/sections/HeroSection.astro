---
import GitHubIcon from "@/components/GitHubIcon.astro";
import LinkedInIcon from "@/components/LinkedInIcon.astro";
---

<section
  class="h-dvh flex items-center bg-neutral bg-linear-to-br from-primary/15 via-neutral via-50% to-secondary/15"
>
  <div class="container mx-auto">
    <div>
      <h1 class="text-7xl font-space-grotesk font-bold text-white">
        Construyendo el <span class="text-primary">Futuro</span>, una linea a la
        vez.
      </h1>
      <p class="font-inter text-xl text-gray-400">
        Desarrollador Web FullStack
      </p>
      <div class="flex my-5 space-x-4 [&>a]:inline-block">
        <a
          href="https://github.com/joseDanielRestrepoOrozco"
          target="_blank"
          rel="noopener noreferrer"
        >
          <GitHubIcon
            classStyles="h-8 w-8 transition hover:scale-130 hover:text-primary duration-300"
          />
        </a>
        <a
          href="https://www.linkedin.com/in/jose-restrepo-orozco"
          target="_blank"
          rel="noopener noreferrer"
        >
          <LinkedInIcon
            classStyles="h-8 w-8 transition hover:scale-130 hover:text-primary duration-300"
          />
        </a>
      </div>
    </div>
    <aside class="hidden md:block">
      <p>Desarrollador web FullStack</p>
    </aside>
  </div>
</section>
