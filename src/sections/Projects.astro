---
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<section id="projects" class="h-250 container mx-auto py-20">
  <h2 class="font-jetbrains-mono text-primary">Proyectos</h2>

  <div class="grid grid-cols-3 grid-rows-2 gap-4">
    <div class="col-span-2">1</div>
    <div class="col-start-3">2</div>
    <div class="row-start-2">3</div>
    <div class="col-span-2 row-start-2">4</div>
  </div>
</section>
